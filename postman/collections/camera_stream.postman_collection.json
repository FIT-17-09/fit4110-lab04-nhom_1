    {
      "name": "04_Boundary_Reliability",
      "item": [
        {
          "name": "POST boundary fps 60 is accepted with warning",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/cameras",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "cameras"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"camera_id\": \"CAM-002\",\n  \"location\": \"Hallway-B\",\n  \"resolution\": \"1920x1080\",\n  \"fps\": 60\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Boundary value 60 returns 201', function () { pm.response.to.have.status(201); });",
                  "if (pm.environment.get('env') !== 'mock') {",
                  "  pm.test('Max FPS response includes warning header', function () { pm.expect(pm.response.headers.has('X-Warning')).to.eql(true); });",
                  "}"
                ]
              }
            }
          ]
        },
