{
  "info": {
    "name": "FIT4110 Lab04 Camera Stream Verification",
    "description": "Postman collection to verify the Dockerized Camera Stream service in Lab 04.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01_Functional",
      "item": [
        {
          "name": "GET health returns 200",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Response has status ok', function () { const json = pm.response.json(); pm.expect(json.status).to.eql('ok'); });",
                  "pm.test('Response has service name and version', function () { const json = pm.response.json(); pm.expect(json.service).to.eql('camera-stream'); pm.expect(json).to.have.property('version'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "POST register camera returns 201",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/cameras",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "cameras"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"camera_id\": \"CAM-001\",\n  \"location\": \"Hallway-A\",\n  \"resolution\": \"1280x720\",\n  \"fps\": 30\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 201', function () { pm.response.to.have.status(201); });",
                  "pm.test('Response follows camera info schema', function () { const json = pm.response.json(); pm.expect(json).to.have.property('camera_id'); pm.expect(json.camera_id).to.match(/^CAM-[0-9]{3}$/); pm.expect(json).to.have.property('status', 'active'); pm.expect(json.fps).to.eql(30); });",
                  "pm.test('Response location matches request', function () { const json = pm.response.json(); pm.expect(json.location).to.eql('Hallway-A'); });",
                  "const created = pm.response.json();",
                  "if (created.camera_id) { pm.environment.set('createdCameraId', created.camera_id); }"
                ]
              }
            }
          ]
        },
        {
          "name": "GET cameras list returns array",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/cameras",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "cameras"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Response is cameras array', function () { const json = pm.response.json(); pm.expect(json).to.be.an('array'); pm.expect(json.length).to.be.at.least(1); });"
                ]
              }
            }
          ]
        },
        {
          "name": "GET camera details returns 200",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/cameras/{{createdCameraId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "cameras",
                "{{createdCameraId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Response camera_id matches saved variable', function () { const json = pm.response.json(); const saved = pm.environment.get('createdCameraId'); pm.expect(json.camera_id).to.eql(saved); });"
                ]
              }
            }
          ]
        },
        {
          "name": "GET camera frame returns image/jpeg",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/cameras/{{createdCameraId}}/frame",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "cameras",
                "{{createdCameraId}}",
                "frame"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Response content type is image/jpeg', function () { pm.response.to.have.header('Content-Type', 'image/jpeg'); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "02_Auth",
      "item": [
        {
          "name": "POST register camera without token returns 401",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/cameras",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "cameras"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"camera_id\": \"CAM-001\",\n  \"location\": \"Hallway-A\",\n  \"resolution\": \"1280x720\",\n  \"fps\": 30\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.environment.get('env') === 'mock') {",
                  "  pm.test('Mock may not enforce auth - document this behavior', function () { pm.expect([200, 201, 401, 403]).to.include(pm.response.code); });",
                  "} else {",
                  "  pm.test('Missing token returns 401', function () { pm.response.to.have.status(401); });",
                  "  function assertProblemDetails() {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json).to.have.property('type');",
                  "    pm.expect(json).to.have.property('title');",
                  "    pm.expect(json).to.have.property('status');",
                  "    pm.expect(json.status).to.be.within(400, 599);",
                  "    pm.expect(json).to.have.property('detail');",
                  "  }",
                  "  assertProblemDetails();",
                  "}"
                ]
              }
            }
          ]
        },
